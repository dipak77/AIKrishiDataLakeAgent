# ── Agrilake configuration ────────────────────────────────────────────────────
# Copy to `.env` and fill in. Everything is optional: connectors fall back to
# bundled offline fixtures when keys are absent or the network is unreachable.
# Priority: shell environment (AGRILAKE_*) > `.env` > built-in defaults.

# data.gov.in (OGD Platform India) API key. Free at https://data.gov.in →
# "My Account" → "Generate API key". Without it, the public demo key is tried
# (heavily rate-limited) and then fixtures are used.
DATA_GOV_IN_API_KEY=
AGRILAKE_DATA_GOV_API_KEY=

# IMD (India Meteorological Department) key, if/when available.
AGRILAKE_IMD_API_KEY=

# FAOSTAT does not require a key for the bulk/API endpoints.
# Set only if you use a mirror or a proxy.
FAOSTAT_BASE_URL=https://fenixservices.fao.org/faostat/api/v1
AGRILAKE_FAOSTAT_BASE_URL=

# Lakehouse location (default: ./data). Object-store path later.
# AGRILAKE_DATA_DIR=./data

# Connector resilience: HTTP timeout (s) and retry count (exponential backoff).
# AGRILAKE_HTTP_TIMEOUT=20
# AGRILAKE_HTTP_RETRIES=3

# Force offline mode (never attempt network; fixtures only).
# AGRILAKE_OFFLINE=false

# Logging verbosity: DEBUG | INFO | WARNING | ERROR.
# AGRILAKE_LOG_LEVEL=INFO

# API Authentication & Ops Guards (optional)
# AGRILAKE_API_TOKEN=your-secret-api-token
# AGRILAKE_RATE_LIMIT=120
# AGRILAKE_RATE_WINDOW=60

# Model & Engine Selection (deterministic defaults unless set)
# AGRI_RERANKER=deterministic          # deterministic | learned | cross_encoder
# AGRI_COMPACTOR=truncation            # truncation | llm
# AGRI_MT_BACKEND=lexicon              # lexicon | indictrans2 | indicmt
# AGRI_VISION_MODEL=                   # path to .onnx / .tflite or HF model id
# AGRI_VISION_LABELS=                  # path to labels JSON map

# Optional HTTP(S) proxy if your deployment sits behind one.
# HTTPS_PROXY=
# HTTP_PROXY=

# ── Ingestion transport (pipelines/http.py, scripts/pipeline_run.py) ──────────
# live    — call the publisher (default)
# record  — call the publisher and capture the response as a cassette
# replay  — serve only from tests/fixtures/cassettes (offline, deterministic)
# offline — never touch the network; connectors fall back to fixtures
# AGRILAKE_TRANSPORT=live

# Refuse to promote fixture-sourced rows: an unreachable source fails the run
# instead of quietly shipping bundled samples (DQ-INGEST-METHOD enforces it).
# AGRILAKE_REQUIRE_LIVE=1

# ── Frontier model policy (opt-in; the default serving path is LLM-free) ──────
# Upper-boundary models only. Anything not on the allowlist is refused
# (ModelTierViolation); if no allowlisted model is reachable the caller stops
# rather than degrading (ModelUnavailable).
# AGRI_MODEL_ALLOWLIST=grok-4.6,qwen3.8-max,claude-opus-5,kimi-k3,gpt-5.6-sol,gemini-3.7-flash,glm-5.3
# AGRI_MODEL_PRIMARY=grok-4.6
# AGRI_MODEL_SECONDARY=qwen3.8-max
# Cross-vendor agreement required before an ontology write is proposed.
# AGRI_MODEL_QUORUM=2
# Hard USD caps; a call that would breach them raises BudgetExceeded.
# AGRI_MODEL_BUDGET_RUN_USD=5
# AGRI_MODEL_BUDGET_DAY_USD=50
# AGRI_MODEL_POLICY=frontier-only/2026-09-02
